{
  // ─── Editor: Font & Appearance ────────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontWeight": "500",
  "editor.fontLigatures": true,
  "editor.tabSize": 2,
  "editor.minimap.enabled": false,
  // ─── Editor: Cursor & Scrolling ───────────────────────────────────────────
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.renderLineHighlight": "none",
  "editor.stickyScroll.enabled": false,
  // ─── Editor: Intellisense & Suggestions ───────────────────────────────────
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.parameterHints.enabled": false,
  "editor.accessibilitySupport": "off",
  "editor.multiCursorLimit": 50000,
  // ─── Editor: Formatting & Code Actions ────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "editor.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": []
  },
  // ─── Editor: Estética LazyVim (guias, colchetes, whitespace) ─────────────
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.renderWhitespace": "boundary",
  // ─── Vim-style (VSCodeVim) ─────────────────────────────────────────────────
  "vim.relativenumber": true,
  "editor.lineNumbers": "relative",
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.view.explorer"
      ]
    }
  ],
  "keyboard.dispatch": "code",
  // ─── Workbench: UI ────────────────────────────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.empty.hint": "hidden",
  "workbench.navigationControl.enabled": false,
  "workbench.tree.enableStickyScroll": false,
  "workbench.layoutControl.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "workbench.activityBar.location": "top",
  "workbench.statusBar.visible": false,
  "workbench.editor.showTabs": "multiple",
  "window.commandCenter": false,
  "window.titleBarStyle": "custom",
  // ─── Workbench: Themes & Icons (Catppuccin) ───────────────────────────────
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.colorTheme": "Catppuccin Mocha",
  "window.autoDetectColorScheme": false,
  // ─── Themes: Catppuccin (paridade com LazyVim/catppuccin.nvim) ────────────
  "catppuccin.italicComments": true,
  "catppuccin.boldKeywords": false,
  "catppuccin.italicKeywords": false,
  // ─── Chat / Agents UI ─────────────────────────────────────────────────────
  "chat.titleBar.signIn.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  // ─── Explorer ─────────────────────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.fileNesting.patterns": {
    "package.json": ".eslint*, eslint.config.*, prettier*, tsconfig*, vite*, pnpm-*, bun.lockb, nest*, package-lock*",
    "tailwind.config.*": "tailwind.config*, postcss.config*",
    ".env.local": ".env*",
    ".env": ".env*"
  },
  // ─── Terminal ─────────────────────────────────────────────────────────────
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.showExitAlert": false,
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },
  // ─── Git ──────────────────────────────────────────────────────────────────
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "diffEditor.ignoreTrimWhitespace": false,
  // ─── Files ────────────────────────────────────────────────────────────────
  "files.associations": {
    ".env.*": "dotenv",
    ".dev.vars": "dotenv",
    ".prettierrc": "json",
    "*.css": "postcss",
    "*.ndjson": "jsonl",
    "*.tsx": "typescriptreact"
  },
  "files.exclude": {
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/.git": true,
    ".vscode": true
    // "node_modules": true
  },
  // ─── Language-specific Formatters ─────────────────────────────────────────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma",
    "editor.formatOnSave": true
  },
  // ─── Emmet ────────────────────────────────────────────────────────────────
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "mdx": "javascriptreact"
  },
  "emmet.syntaxProfiles": {
    "javascript": "jsx",
    "mdx": "jsx"
  },
  // ─── ESLint ───────────────────────────────────────────────────────────────
  "eslint.validate": [
    "typescript",
    "typescriptreact",
    "javascript",
    "javascriptreact",
    "graphql"
  ],
  // ─── Tailwind CSS ─────────────────────────────────────────────────────────
  "tailwindCSS.experimental.classRegex": [
    [
      "tv\\(([^)]*)\\)",
      "cva\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ],
    "class:\\s*?[\"'`]([^\"'`]*).*?,",
    "tw\\('([^']*)'\\)"
  ],
  // ─── GitLens ──────────────────────────────────────────────────────────────
  "gitlens.codeLens.recentChange.enabled": false,
  "gitlens.codeLens.authors.enabled": false,
  "gitlens.advanced.messages": {
    "suppressIntegrationDisconnectedTooManyFailedRequestsWarning": true,
    "suppressIntegrationRequestTimedOutWarning": true
  },
  // ─── Prisma ───────────────────────────────────────────────────────────────
  "prisma.hidePrisma6Prompts": true,
  // ─── Claude Code ──────────────────────────────────────────────────────────
  "claudeCode.preferredLocation": "panel",
  // ─── Python ───────────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  // ─── Security & Updates ───────────────────────────────────────────────────
  "security.workspace.trust.untrustedFiles": "newWindow",
  "security.promptForLocalFileProtocolHandling": false,
  "update.mode": "start",
  "extensions.ignoreRecommendations": true,
  "claudeCode.hideOnboarding": true,
  "terminal.integrated.initialHint": false
}
