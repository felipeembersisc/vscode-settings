{
  // ─── Tema & Ícones ────────────────────────────────────────────────────────
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "fluent-icons",
  "window.autoDetectColorScheme": false,

  // ─── Editor: Fonte & Aparência ────────────────────────────────────────────
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono",
  "editor.lineHeight": 1.5,
  "editor.letterSpacing": 0,
  "editor.fontLigatures": false,
  "editor.tabSize": 3,
  "editor.lineNumbers": "relative",
  "editor.minimap.renderCharacters": false,

  // ─── Editor: Cursor & Rolagem ─────────────────────────────────────────────
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.cursorBlinking": "blink",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.hideCursorInOverviewRuler": true,
  "editor.renderLineHighlight": "line",
  "editor.stickyScroll.enabled": false,

  // ─── Editor: Guias, colchetes, whitespace (estética LazyVim) ─────────────
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.renderWhitespace": "boundary",
  "editor.semanticHighlighting.enabled": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": []
  },

  // ─── Editor: Intellisense & Sugestões ─────────────────────────────────────
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.parameterHints.enabled": false,
  "editor.accessibilitySupport": "off",
  "editor.multiCursorLimit": 50000,

  // ─── Editor: Formatação & Code Actions ────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // ─── Workbench & Janela ───────────────────────────────────────────────────
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "multiple",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.empty.hint": "hidden",
  "workbench.navigationControl.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "workbench.tree.indent": 14,
  "workbench.tree.enableStickyScroll": false,
  "window.titleBarStyle": "custom",
  "window.commandCenter": false,
  "window.restoreWindows": "none",
  "window.confirmSaveUntitledWorkspace": false,

  // ─── Explorer ─────────────────────────────────────────────────────────────
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,
  "explorer.sortOrder": "foldersNestsFiles",
  "explorer.fileNesting.patterns": {
    "package.json": ".eslint*, eslint.config.*, prettier*, tsconfig*, vite*, pnpm-*, bun.lockb, nest*, package-lock*",
    "tailwind.config.*": "tailwind.config*, postcss.config*",
    ".env.local": ".env*",
    ".env": ".env*"
  },

  // ─── Arquivos ─────────────────────────────────────────────────────────────
  "files.associations": {
    ".env.*": "dotenv",
    ".dev.vars": "dotenv",
    ".prettierrc": "json",
    "*.css": "postcss",
    "*.ndjson": "jsonl",
    "*.tsx": "typescriptreact"
  },
  "files.exclude": {
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/.git": true,
    ".vscode": true
    // "node_modules": true
  },

  // ─── Terminal ─────────────────────────────────────────────────────────────
  "terminal.integrated.defaultProfile.osx": "fish",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontFamily": "JetBrains Mono",
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.showExitAlert": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },

  // ─── Git ──────────────────────────────────────────────────────────────────
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",
  "diffEditor.ignoreTrimWhitespace": false,

  // ─── Formatadores por linguagem ───────────────────────────────────────────
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "vscode.json-language-features", "editor.formatOnSave": false },
  "[jsonc]": { "editor.defaultFormatter": "vscode.json-language-features", "editor.formatOnSave": false },
  "[prisma]": { "editor.defaultFormatter": "Prisma.prisma", "editor.formatOnSave": true },

  // ─── ESLint & Biome ───────────────────────────────────────────────────────
  "eslint.validate": ["typescript", "typescriptreact", "javascript", "javascriptreact", "graphql"],
  "biome.suggestInstallingGlobally": false,

  // ─── Tailwind CSS ─────────────────────────────────────────────────────────
  "tailwindCSS.experimental.classRegex": [
    ["tv\\(([^)]*)\\)", "cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    "class:\\s*?[\"'`]([^\"'`]*).*?,",
    "tw\\('([^']*)'\\)"
  ],

  // ─── Emmet ────────────────────────────────────────────────────────────────
  "emmet.includeLanguages": { "javascript": "javascriptreact", "mdx": "javascriptreact" },
  "emmet.syntaxProfiles": { "javascript": "jsx", "mdx": "jsx" },

  // ─── Prisma ───────────────────────────────────────────────────────────────
  "prisma.hidePrisma6Prompts": true,

  // ─── Chat & Claude Code ───────────────────────────────────────────────────
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "claudeCode.preferredLocation": "panel",
  "claudeCode.hideOnboarding": true,

  // ─── Segurança, atualizações & extensões ──────────────────────────────────
  "security.workspace.trust.untrustedFiles": "newWindow",
  "security.promptForLocalFileProtocolHandling": false,
  "update.mode": "start",
  "extensions.ignoreRecommendations": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://spec.openapis.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  }
}
